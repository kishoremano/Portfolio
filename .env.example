# Resend API Key for server-side contact form submissions
# Obtain your key at https://resend.com/api-keys
# Add this environment variable in your Vercel Project Settings > Environment Variables
RESEND_API_KEY=re_your_api_key_here

# (Optional) Verified domain sender email on Resend.
# If omitted, defaults to "Portfolio Contact <onboarding@resend.dev>"
# RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
